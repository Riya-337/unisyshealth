[Unit]
Description=SentiHealth Infrastructure Health Monitor Daemon
After=network.target

[Service]
Type=simple
User=sentinel
WorkingDirectory=/opt/sentihealth
ExecStart=/usr/bin/python3 /opt/sentihealth/scripts/health_monitor.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/sentihealth/logs/health_monitor.log
StandardError=append:/opt/sentihealth/logs/health_monitor.log

[Install]
WantedBy=multi-user.target
